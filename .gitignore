# Python and tool caches
.venv/
__pycache__/
*.py[cod]
.mypy_cache/
.ruff_cache/
.pytest_cache/
*.egg-info/

# Run logs
logs/

# The dataset is not stored here (size and licence): see data/README.md.
# Only checksums, the merge report and three small sample files are kept.
data/raw/*
!data/raw/merge_report.txt
data/interim/*
data/processed/*
!data/interim/.gitkeep
!data/processed/.gitkeep

# Trained models are large; scripts/13_export_model.py rebuilds them
models/
*.joblib

# Outputs of the small trial profile (python run.py baseline-quick and friends)
results/**/*_quick*
results/analysis_quick/
paper/figures_quick/
paper/tables_quick/

# Generated text files of the paper build
paper/numbers*.tex
build/
